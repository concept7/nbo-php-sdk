{
    "name": "concept7/nbo-php-sdk",
    "description": "An SDK written in PHP to work with the NieuwbouwOffice API",
    "keywords": [
        "concept7",
        "nieuwbouw-office",
        "nbo-php-sdk"
    ],
    "homepage": "https://github.com/concept7/nbo-php-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Jan Henk Hazelaar",
            "email": "janhenk@concept7.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "nesbot/carbon": "^3.0",
        "saloonphp/saloon": "^4.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "NieuwbouwOffice\\PhpSdk\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NieuwbouwOffice\\PhpSdk\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
